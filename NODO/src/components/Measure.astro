---
import { getTextos } from '../i18n';
import SectionIndex from './SectionIndex.astro';
const t = getTextos(Astro.currentLocale).measure;
---
<section class="section" id="medida" aria-labelledby="medida-titulo">
  <div class="container">
    <SectionIndex num="05" label={t.index} />
    <div class="measure">
      <div class="measure__head reveal">
        <h2 id="medida-titulo" class="section__title">{t.title}</h2>
        <p class="section__lead">{t.lead}</p>
      </div>

      <ul class="figures">
        {t.figures.map((fig) => (
          <li class="figure reveal">
            <p class="figure__value">
              {fig.value.map((parte) =>
                typeof parte === 'number'
                  ? <span data-count={parte}>{parte}</span>
                  : fig.small ? <span class="figure__text">{parte}</span> : parte
              )}
            </p>
            <p class="figure__unit">{fig.unit}</p>
            <p class="figure__desc">{fig.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // Conteo de los números al entrar en pantalla
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const contador = { valor: 0 };
      gsap.to(contador, {
        valor: Number(el.dataset.count),
        duration: 1.2,
        ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        onUpdate: () => { el.textContent = String(Math.round(contador.valor)); },
      });
    });
  });
</script>

<style>
.measure { display: grid; gap: 48px; }
.measure__head { display: grid; gap: 20px; }

.figures { display: grid; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--tinta); }
.figure { display: grid; gap: 6px; align-content: start; padding: 28px 0; border-bottom: 1px solid var(--linea); }
.figure__value {
  /* Caja de altura fija: los tres datos quedan alineados abajo */
  display: flex;
  align-items: flex-end;
  font-weight: 800;
  font-stretch: 125%;
  font-size: clamp(3.5rem, 12vw, 6rem);
  line-height: .95;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}
.figure__text {
  font-size: clamp(2rem, 5vw, 2.75rem);
  font-stretch: 118%;
  line-height: 1.1;
  letter-spacing: -0.01em;
}
.figure__unit {
  font-family: var(--mono);
  font-size: 0.8125rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--naranja-oscuro);
}
.figure__desc { color: var(--tinta-suave); max-width: 30ch; }

@media (min-width: 900px) {
  .figures { grid-template-columns: repeat(3, 1fr); border-top: 0; }
  .figure { padding: 32px 32px 0 0; border-bottom: 0; border-top: 1px solid var(--tinta); }
  .figure + .figure { padding-left: 32px; border-left: 1px solid var(--linea); }
  .figure__value { min-height: calc(clamp(3.5rem, 12vw, 6rem) * .95); }
}
</style>
