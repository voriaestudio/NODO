---
import { getTextos } from '../i18n';
import { waLink, INSTAGRAM, EMAIL } from '../config';
const t = getTextos(Astro.currentLocale);
const secciones = t.nav.items.filter((item) => item.href !== '#contacto');
---
<footer class="footer">
  <!-- Una sola franja: símbolo · secciones · contacto -->
  <div class="container footer__row">
    <a href="#inicio" class="footer__logo" aria-label={t.nav.home}>
      <img src="/img/nodo-simbolo.png" alt="NODO" width="240" height="139" loading="lazy" />
    </a>

    <nav aria-label="Secundaria">
      <ul class="footer__links">
        {secciones.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <ul class="footer__links footer__contact">
      <li><a href={waLink(t.footer.whatsappMsg)} target="_blank" rel="noopener">WhatsApp</a></li>
      {INSTAGRAM && <li><a href={`https://instagram.com/${INSTAGRAM}`} target="_blank" rel="noopener">Instagram</a></li>}
      {EMAIL && <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>}
    </ul>
  </div>

  <div class="container">
    <p class="footer__bottom">{t.footer.copyright}</p>
  </div>
</footer>

<style>
.footer {
  padding-block: 32px 24px;
  background: var(--papel);
  color: var(--tinta-suave);
  font-size: 0.9375rem;
}

/* En el celular: todo centrado, uno debajo del otro */
.footer__row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}
.footer__logo img { width: 56px; height: auto; }

.footer__links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px 24px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.footer__links a { text-decoration: none; transition: color .2s; }
.footer__links a:hover { color: var(--naranja-oscuro); }
.footer__contact a { font-weight: 600; color: var(--tinta); }

.footer__bottom {
  margin-top: 24px;
  padding-top: 16px;
  border-top: 1px solid var(--linea);
  text-align: center;
  font-family: var(--mono);
  font-size: 0.75rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

/* En la compu: una sola fila, con los links al centro */
@media (min-width: 768px) {
  .footer__row { flex-direction: row; justify-content: space-between; }
}
</style>
