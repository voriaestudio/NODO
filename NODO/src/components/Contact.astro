---
import { getTextos } from '../i18n';
import SectionIndex from './SectionIndex.astro';
const t = getTextos(Astro.currentLocale).contact;
const f = t.fields;
---
<section class="contact" id="contacto" aria-labelledby="contacto-titulo">
  <div class="container">
    <SectionIndex num="06" label={t.index} />
    <div class="contact__grid">
      <div class="contact__main reveal">
        <h2 id="contacto-titulo" class="section__title">{t.title}</h2>
        <p class="contact__lead">{t.lead}</p>
        <p class="contact__note">{t.note}</p>
      </div>

      <!-- Formulario: no se envía a ningún servidor; arma el mensaje y abre WhatsApp -->
      <form class="quote reveal" id="cotizacion" novalidate data-mensaje={JSON.stringify(t.message)}>
        <p class="quote__title">{t.formTitle}</p>

        <div class="field field--full">
          <label for="f-nombre">{f.nombre.label} <span aria-hidden="true">*</span></label>
          <input id="f-nombre" name="nombre" type="text" autocomplete="organization" required placeholder={f.nombre.placeholder} />
        </div>

        <div class="field">
          <label for="f-prenda">{f.prenda.label} <span aria-hidden="true">*</span></label>
          <select id="f-prenda" name="prenda" required>
            <option value="" selected disabled>{f.prenda.placeholder}</option>
            {f.prenda.options.map((op) => <option>{op}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="f-cantidad">{f.cantidad.label} <span aria-hidden="true">*</span></label>
          <input id="f-cantidad" name="cantidad" type="text" inputmode="numeric" required placeholder={f.cantidad.placeholder} />
        </div>

        <div class="field">
          <label for="f-colores">{f.colores.label}</label>
          <input id="f-colores" name="colores" type="text" placeholder={f.colores.placeholder} />
        </div>

        <div class="field">
          <label for="f-talles">{f.talles.label}</label>
          <input id="f-talles" name="talles" type="text" placeholder={f.talles.placeholder} />
        </div>

        <div class="field field--full">
          <label for="f-fecha">{f.fecha.label}</label>
          <input id="f-fecha" name="fecha" type="date" />
        </div>

        <fieldset class="field field--full choice">
          <legend>{f.diseno.label}</legend>
          <div class="choice__options">
            {f.diseno.options.map((op, i) => (
              <label><input type="radio" name="diseno" value={op.value} checked={i === 0} /> {op.label}</label>
            ))}
          </div>
        </fieldset>

        <fieldset class="field field--full choice">
          <legend>{f.etapa.label}</legend>
          <div class="choice__options">
            {f.etapa.options.map((op, i) => (
              <label><input type="radio" name="etapa" value={op.value} checked={i === 0} /> {op.label}</label>
            ))}
          </div>
        </fieldset>

        <div class="field field--full">
          <label for="f-detalle">{f.detalle.label}</label>
          <textarea id="f-detalle" name="detalle" rows="3" placeholder={f.detalle.placeholder}></textarea>
        </div>

        <p class="quote__error" role="alert" hidden>{t.error}</p>

        <button class="btn btn--primary btn--lg quote__submit" type="submit">
          {t.submit}
          <svg class="btn__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  import { waLink } from '../config';

  const form = document.querySelector<HTMLFormElement>('#cotizacion')!;
  const error = form.querySelector<HTMLElement>('.quote__error')!;
  const txt = JSON.parse(form.dataset.mensaje ?? '{}');
  const campoFecha = form.querySelector<HTMLInputElement>('#f-fecha')!;
  campoFecha.min = new Date().toISOString().slice(0, 10);

  const obligatorios = form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]');

  form.addEventListener('submit', (e) => {
    e.preventDefault();

    // Validación: marca los obligatorios vacíos y lleva el foco al primero
    let valido = true;
    obligatorios.forEach((campo) => {
      const vacio = !campo.value.trim();
      campo.closest('.field')!.classList.toggle('is-error', vacio);
      campo.setAttribute('aria-invalid', String(vacio));
      if (vacio && valido) { campo.focus(); valido = false; }
    });
    error.hidden = valido;
    if (!valido) return;

    // Arma el mensaje con lo completado (omite lo vacío)
    const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
    // La fecha llega como 2026-12-15: la pasamos a 15/12/2026 para el mensaje
    if (d.fecha) d.fecha = d.fecha.split('-').reverse().join('/');
    const linea = (clave: string) => (d[clave]?.trim() ? `• ${txt[clave]}: ${d[clave].trim()}` : '');
    const mensaje = [
      txt.greeting.replace('{nombre}', d.nombre.trim()),
      ...['prenda', 'cantidad', 'colores', 'talles', 'fecha', 'diseno', 'etapa', 'detalle'].map(linea),
    ].filter(Boolean).join('\n');

    const url = waLink(mensaje);
    const ventana = window.open(url, '_blank');
    if (ventana) ventana.opener = null;  // seguridad: la pestaña nueva no controla esta
    else window.location.href = url;     // si el navegador bloquea la pestaña, abre acá
  });

  // Quita la marca de error apenas completan el campo
  obligatorios.forEach((campo) => {
    campo.addEventListener('input', () => {
      if (!campo.value.trim()) return;
      campo.closest('.field')!.classList.remove('is-error');
      campo.removeAttribute('aria-invalid');
    });
  });
</script>

<style>
.contact {
  padding-block: 24px 56px;
  background: var(--papel-2);
}

.contact__grid { display: grid; gap: 48px; }
.contact__main { display: grid; gap: 24px; align-content: start; }
.contact .section__title { font-size: clamp(2rem, 5vw, 3.25rem); max-width: 12ch; }
.contact__lead { max-width: 46ch; font-size: 1.125rem; color: var(--tinta-suave); }
.contact__note { max-width: 46ch; font-size: 0.9375rem; color: var(--tinta-suave); }


/* Formulario de cotización: tarjeta naranja suave con las esquinas en chaflán, como las fotos */
.quote {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px 16px;
  padding: 32px 20px;
  background: rgba(238, 74, 21, .09);
  clip-path: polygon(var(--chaflan) 0, 100% 0, 100% calc(100% - var(--chaflan)), calc(100% - var(--chaflan)) 100%, 0 100%, 0 var(--chaflan));
}
.quote__title {
  font-family: var(--mono);
  font-size: 0.8125rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--naranja-oscuro);
}

.field { display: grid; gap: 8px; min-width: 0; margin: 0; padding: 0; border: 0; }
.field label,
.field legend {
  padding: 0;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--tinta);
}
.field label span { color: var(--naranja-oscuro); }

.field input[type="text"],
.field input[type="date"],
.field select,
.field textarea {
  width: 100%;
  min-height: 50px;
  padding: 12px 16px;
  font: inherit;
  font-size: 1rem;           /* 16px evita el zoom automático en iPhone */
  color: var(--tinta);
  background: #FFFFFF;
  border: 1px solid rgba(238, 74, 21, .25);
  border-radius: 4px;   /* apenas redondeado */
  transition: border-color .2s, box-shadow .2s;
}
.field textarea { resize: vertical; min-height: 96px; }
.field input::placeholder,
.field textarea::placeholder { color: #8A857A; }
.field select {
  appearance: none;
  padding-right: 44px;
  background-image: linear-gradient(45deg, transparent 50%, var(--naranja-oscuro) 50%), linear-gradient(135deg, var(--naranja-oscuro) 50%, transparent 50%);
  background-position: calc(100% - 22px) 22px, calc(100% - 17px) 22px;
  background-size: 5px 5px;
  background-repeat: no-repeat;
}
.field select:invalid { color: #8A857A; }

.field input:hover, .field select:hover, .field textarea:hover { border-color: rgba(238, 74, 21, .5); }
.field input:focus, .field select:focus, .field textarea:focus {
  outline: none;
  border-color: var(--naranja);
  box-shadow: 0 0 0 3px rgba(238, 74, 21, .18);
}
/* Ícono del calendario en naranja */
.field input[type="date"]::-webkit-calendar-picker-indicator { cursor: pointer; filter: invert(33%) sepia(90%) saturate(2000%) hue-rotate(355deg); }
/* iPhone: sin esto, la caja de fecha sale más baja, centrada y con otro estilo */
.field input[type="date"] {
  -webkit-appearance: none;
  appearance: none;
  display: block;
  min-height: 50px;
  line-height: 1.5;
  text-align: left;
}
.field input[type="date"]::-webkit-date-and-time-value { text-align: left; margin: 0; }

.field.is-error input, .field.is-error select { border-color: var(--naranja-oscuro); background-color: #FFF3EE; }

/* Opciones de elección: círculo de selección, sin cajas */
.choice__options { display: flex; flex-wrap: wrap; gap: 10px 24px; }
.choice__options label {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-height: 44px;
  font-weight: 500;
  color: var(--tinta-suave);
  cursor: pointer;
  transition: color .2s;
}
.choice__options label::before {
  content: "";
  flex: none;
  width: 20px;
  height: 20px;
  border: 1.5px solid rgba(238, 74, 21, .45);
  border-radius: 50%;
  background: #FFFFFF;
  transition: border-color .2s, box-shadow .2s;
}
.choice__options input { position: absolute; opacity: 0; pointer-events: none; }
.choice__options label:hover { color: var(--tinta); }
.choice__options label:hover::before { border-color: var(--naranja); }
/* Seleccionada: punto naranja adentro del círculo */
.choice__options label:has(input:checked) { color: var(--tinta); font-weight: 600; }
.choice__options label:has(input:checked)::before { border-color: var(--naranja); box-shadow: inset 0 0 0 4px #FFFFFF, inset 0 0 0 10px var(--naranja); }
.choice__options label:has(input:focus-visible)::before { outline: 3px solid var(--naranja); outline-offset: 2px; }

.quote__error { font-size: 0.9375rem; font-weight: 600; color: var(--naranja-oscuro); }
.quote__submit { justify-self: stretch; }

@media (min-width: 640px) {
  .quote { grid-template-columns: 1fr 1fr; padding: 40px; }
  .quote__title, .field--full, .quote__error, .quote__submit { grid-column: 1 / -1; }
  .quote__submit { justify-self: start; }
}

@media (min-width: 900px) {
  .contact { padding-block: 32px 88px; }
  .contact__grid { grid-template-columns: 0.85fr 1.15fr; gap: 72px; align-items: start; }
  .contact__main { position: sticky; top: 120px; }
}
</style>
