---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getTextos } from '../i18n';

const t = getTextos(Astro.currentLocale);
const idioma = Astro.currentLocale ?? 'es';
---
<!doctype html>
<html lang={idioma === 'es' ? 'es-AR' : idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" href="/favicon.png" type="image/png" />

    <!-- Vista previa al compartir el link (WhatsApp, redes) -->
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />

    <!-- Tipografías: Archivo (textos y títulos) + IBM Plex Mono (índices y datos) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Activa las animaciones de scroll solo si hay JS y el usuario no pidió reducir el movimiento.
         Va acá arriba para que no se vea un parpadeo al cargar. -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js');
      }
    </script>
  </head>
  <body>
    <div class="progress" aria-hidden="true"><span class="progress__bar"></span></div>
    <a class="skip-link" href="#contenido">{t.nav.skip}</a>

    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <script>
      // Animaciones globales con GSAP: aparición al hacer scroll y barra de progreso
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
        // Textos y fotos: al entrar en pantalla reciben .is-in y el CSS hace la transición
        ScrollTrigger.batch('.reveal, .photo--mask', {
          start: 'top 88%',
          once: true,
          onEnter: (elementos) => elementos.forEach((el, i) => {
            gsap.delayedCall(i * 0.08, () => el.classList.add('is-in'));
          }),
        });

        // Barra de progreso de lectura
        ScrollTrigger.create({
          start: 0,
          end: 'max',
          onUpdate: (self) => document.documentElement.style.setProperty('--scroll', String(self.progress)),
        });
      });
    </script>
  </body>
</html>
