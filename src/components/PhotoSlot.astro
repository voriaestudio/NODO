---
// Hueco de foto. Cuando lleguen las fotos reales, se pasa "src" y se muestra la imagen.
interface Props {
  label: string;           // texto que se ve mientras no hay foto
  alt: string;             // descripción de la foto (accesibilidad y SEO)
  src?: string;            // ruta de la foto, ej.: '/img/trabajos/aus.webp'
  width?: number;
  height?: number;
  reveal?: 'load' | 'scroll'; // la máscara se abre al cargar o al hacer scroll
}
const { label, alt, src, width, height, reveal = 'scroll' } = Astro.props;
---
<figure class:list={['photo', reveal === 'load' ? 'photo--mask-load' : 'photo--mask']}>
  {src ? (
    <img class="photo__inner" src={src} alt={alt} width={width} height={height}
         loading={reveal === 'load' ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <>
      <div class="photo__inner" role="img" aria-label={alt}></div>
      <figcaption class="photo__label">{label}</figcaption>
    </>
  )}
</figure>
