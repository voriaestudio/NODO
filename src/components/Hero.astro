---
import { getTextos } from '../i18n';
import PhotoSlot from './PhotoSlot.astro';
const t = getTextos(Astro.currentLocale).hero;
---
<section class="hero" id="inicio">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="eyebrow anim" style="--d:0">{t.eyebrow}</p>
      <h1 class="hero__title">
        <span class="line"><span class="anim-line" style="--d:1">{t.title1}</span></span>
        <span class="line"><span class="anim-line accent" style="--d:2">{t.title2}</span></span>
      </h1>
      <p class="hero__lead anim" style="--d:3">{t.lead}</p>
      <div class="hero__actions anim" style="--d:4">
        <a class="btn btn--primary" href="#contacto">{t.cta}</a>
        <a class="btn btn--ghost" href="#trabajos">{t.secondary}</a>
      </div>
      <p class="hero__tags anim" style="--d:5">{t.tags}</p>
    </div>

    <div class="hero__media">
      <PhotoSlot label={t.photo} alt={t.photoAlt} src={t.photoSrc} width={1200} height={1500} reveal="load" />
    </div>
  </div>
</section>

<style>
.hero { padding-block: 40px 64px; }
.hero__grid { display: grid; gap: 40px; }
.hero__text { display: grid; gap: 24px; align-content: center; }
.hero__title { font-size: clamp(2.4rem, 7vw, 4.5rem); line-height: 1; }
.hero__lead { max-width: 50ch; font-size: 1.125rem; color: var(--tinta-suave); }
.hero__actions { display: flex; flex-direction: column; gap: 12px; }
.hero__tags {
  padding-top: 18px;
  border-top: 1px solid var(--linea);
  font-family: var(--mono);
  font-size: 0.8125rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--tinta-suave);
}
.hero__media { aspect-ratio: 4 / 3; max-width: 100%; }

@media (min-width: 560px) {
  .hero__actions { flex-direction: row; flex-wrap: wrap; }
}
@media (min-width: 900px) {
  .hero { padding-block: 64px 96px; }
  /* La foto toma la misma altura que el bloque de texto */
  .hero__grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 64px; align-items: stretch; }
  .hero__media { aspect-ratio: auto; min-height: 360px; }
}
</style>
