---
import { getTextos } from '../i18n';
import SectionIndex from './SectionIndex.astro';
const t = getTextos(Astro.currentLocale).process;
---
<section class="section" id="proceso" aria-labelledby="proceso-titulo">
  <div class="container">
    <SectionIndex num="03" label={t.index} />
    <h2 id="proceso-titulo" class="section__title reveal">{t.title}</h2>

    <div class="timeline">
      <div class="timeline__track" aria-hidden="true"><span class="timeline__fill"></span></div>
      <ol class="timeline__steps">
        {t.steps.map((step, i) => (
          <li class="step">
            <span class="step__dot" aria-hidden="true"></span>
            <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__desc">{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  // La línea del proceso se dibuja con el scroll (GSAP ScrollTrigger)
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const timeline = document.querySelector<HTMLElement>('.timeline')!;
  const pasos = timeline.querySelectorAll('.step');
  const pintar = (progreso: number) => {
    timeline.style.setProperty('--progreso', String(progreso));
    pasos.forEach((paso, i) => paso.classList.toggle('is-active', progreso >= i / (pasos.length - 1) - 0.01));
  };

  gsap.matchMedia()
    .add('(prefers-reduced-motion: no-preference)', () => {
      ScrollTrigger.create({
        trigger: timeline,
        start: 'top 70%',
        end: 'bottom 55%',
        scrub: 0.4,
        onUpdate: (self) => pintar(self.progress),
      });
    })
    .add('(prefers-reduced-motion: reduce)', () => pintar(1));
</script>

<style>
.timeline { position: relative; margin-top: 56px; }
.timeline__steps { display: grid; gap: 36px; margin: 0; padding: 0 0 0 44px; list-style: none; }

/* Línea vertical en móvil */
.timeline__track {
  position: absolute;
  left: 10px;
  top: 6px;
  bottom: 6px;
  width: 2px;
  background: var(--linea);
}
.timeline__fill {
  position: absolute;
  inset: 0;
  background: var(--naranja);
  transform-origin: top;
  transform: scaleY(var(--progreso, 0));
}

.step { position: relative; display: grid; gap: 8px; }
.step__dot {
  position: absolute;
  left: -44px;
  top: 2px;
  width: 22px;
  height: 22px;
  background: var(--papel);
  border: 2px solid var(--linea);
  transform: rotate(45deg) scale(.75);
  transition: background-color .4s, border-color .4s, transform .4s var(--ease);
}
.step.is-active .step__dot { background: var(--naranja); border-color: var(--naranja); transform: rotate(45deg) scale(1); }
.step__num { font-family: var(--mono); font-size: 0.8125rem; color: var(--tinta-suave); transition: color .4s; }
.step.is-active .step__num { color: var(--naranja-oscuro); }
.step__title { font-size: 1.375rem; font-stretch: 112%; }
.step__desc { color: var(--tinta-suave); max-width: 32ch; }

/* Línea horizontal en escritorio */
@media (min-width: 900px) {
  .timeline__steps { grid-template-columns: repeat(5, 1fr); gap: 0; padding: 48px 0 0; }
  .timeline__track { left: 11px; right: calc(20% - 11px); top: 10px; bottom: auto; width: auto; height: 2px; }
  .timeline__fill { transform-origin: left; transform: scaleX(var(--progreso, 0)); }
  .step { padding-right: 28px; }
  .step__dot { left: 0; top: -48px; }
  .step__title { font-size: 1.25rem; }
}
</style>
