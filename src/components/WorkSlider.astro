---
// Fotos de un trabajo. Con una sola foto se ve fija; con varias, se deslizan
// (con el dedo en el celular, o con las flechas y los puntos en la compu).
import { getTextos } from '../i18n';

interface Props {
  photos: string[];
  alt: string;   // descripción del trabajo; a cada foto se le suma "foto 1 de 3"
  name: string;  // nombre del cliente, para el lector de pantalla
}
const { photos, alt, name } = Astro.props;
const t = getTextos(Astro.currentLocale).works;
const total = photos.length;
const altDe = (i: number) =>
  total > 1 ? `${alt}, ${t.photoOf.replace('{n}', String(i + 1)).replace('{total}', String(total))}` : alt;
---
<div class="slider photo photo--mask" data-slider role="group" aria-roledescription="carrusel" aria-label={name}>
  <div class="slider__track" tabindex={total > 1 ? 0 : undefined}>
    {photos.map((src, i) => (
      <img class="slider__img" src={src} alt={altDe(i)} width="1200" height="1500" loading="lazy" decoding="async" />
    ))}
  </div>

  {total > 1 && (
    <>
      <button class="slider__btn slider__btn--prev" type="button" aria-label={t.prev} data-prev>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5m6-6-6 6 6 6" /></svg>
      </button>
      <button class="slider__btn slider__btn--next" type="button" aria-label={t.next} data-next>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
      </button>
      <div class="slider__dots" aria-hidden="true">
        {photos.map((_, i) => <span class:list={['slider__dot', { 'is-active': i === 0 }]}></span>)}
      </div>
    </>
  )}
</div>

<script>
  // Flechas y puntos: el deslizamiento en sí lo hace el CSS (scroll-snap)
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
    const track = slider.querySelector<HTMLElement>('.slider__track')!;
    const dots = slider.querySelectorAll('.slider__dot');
    if (!dots.length) return;

    const mover = (dir: number) => track.scrollBy({ left: dir * track.clientWidth, behavior: 'smooth' });
    slider.querySelector('[data-prev]')?.addEventListener('click', () => mover(-1));
    slider.querySelector('[data-next]')?.addEventListener('click', () => mover(1));

    // Con el teclado: flechas izquierda y derecha cuando el carrusel tiene el foco
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); mover(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); mover(-1); }
    });

    // Marca el punto de la foto que se está viendo
    let pendiente = false;
    track.addEventListener('scroll', () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        const actual = Math.round(track.scrollLeft / track.clientWidth);
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === actual));
        pendiente = false;
      });
    }, { passive: true });
  });
</script>

<style>
.slider { aspect-ratio: 4 / 5; height: auto; }

.slider__track {
  display: flex;
  height: 100%;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;           /* oculta la barra de scroll */
  overscroll-behavior-x: contain;
}
.slider__track::-webkit-scrollbar { display: none; }
.slider__track:focus-visible { outline: 3px solid var(--naranja); outline-offset: -3px; }

.slider__img {
  flex: 0 0 100%;
  width: 100%;
  height: 100%;
  object-fit: cover;
  scroll-snap-align: start;
}

/* Flechas: aparecen al pasar el mouse (en el celular se desliza con el dedo) */
.slider__btn {
  position: absolute;
  top: 50%;
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  padding: 0;
  background: rgba(250, 249, 246, .92);
  border: 0;
  cursor: pointer;
  opacity: 0;
  transform: translateY(-50%);
  transition: opacity .25s, background-color .25s;
}
.slider__btn svg { width: 20px; height: 20px; fill: none; stroke: var(--tinta); stroke-width: 2; }
.slider__btn:hover { background: var(--naranja); }
.slider__btn--prev { left: 12px; }
.slider__btn--next { right: 12px; }
.slider:hover .slider__btn,
.slider__btn:focus-visible { opacity: 1; }
@media (hover: none) { .slider__btn { display: none; } }

/* Puntos: cuántas fotos hay y cuál se está viendo */
.slider__dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 14px;
  display: flex;
  justify-content: center;
  gap: 6px;
  pointer-events: none;
}
.slider__dot {
  width: 7px;
  height: 7px;
  background: rgba(250, 249, 246, .6);
  box-shadow: 0 0 0 1px rgba(23, 23, 23, .15);
  transform: rotate(45deg);
  transition: background-color .25s;
}
.slider__dot.is-active { background: var(--naranja); }

@media (prefers-reduced-motion: reduce) {
  .slider__track { scroll-behavior: auto; }
}
</style>
