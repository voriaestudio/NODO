---
import { getTextos } from '../i18n';
const items = getTextos(Astro.currentLocale).marquee;
---
<!-- Decorativa: la lista se repite dos veces para que el movimiento no tenga corte -->
<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {[...items, ...items].map((item) => <span>{item}</span>)}
  </div>
</div>

<style>
.marquee {
  overflow: hidden;
  background: var(--tinta);
  color: var(--oscuro-texto);
  padding-block: 18px;
}
.marquee__track {
  display: flex;
  width: max-content;
  animation: marquesina 45s linear infinite;
}
.marquee:hover .marquee__track { animation-play-state: paused; }
.marquee span {
  display: inline-flex;
  align-items: center;
  gap: 28px;
  padding-right: 28px;
  font-weight: 700;
  font-stretch: 115%;
  font-size: 1rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
}
.marquee span::after {
  /* Separador: el símbolo del logo en versión clara */
  content: "";
  width: 28px;
  height: 16px;
  background: url('/img/nodo-simbolo-claro.png') center / contain no-repeat;
}
@keyframes marquesina { to { transform: translateX(-50%); } }
</style>
